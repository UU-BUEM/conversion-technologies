# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# setuptools-scm generated version file
src/conversion_technologies/_version.py

# Conda build artifacts
.conda-bld/
conda-bld/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pytype/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging
*.whl
*.tar.gz

# Virtual environments (repo-root only -- NOT infrastructure/env/, which holds
# the tracked conda_env.yml spec, and NOT any nested */data/ package-data dir)
.venv/
/venv/
/env/

# IDE / editor
.vscode/*
!.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Environment secrets
.env

# Run outputs / local data (never committed) -- repo-root only; does NOT match
# the tracked src/conversion_technologies/**/data/ package-data directories
outputs/
/data/
*.log

# Local git/push helper scripts (per-developer, not canonical)
push.sh
push.ps1
.commit-message.md

# Ad hoc local notes
conversion_technologies_improvement*.txt

# Claude Code context (CLAUDE.md, .claude/) -- local-only, not pushed to
# GitHub: internal AI-agent working notes/decision log, not meant for
# external partners (EnerPlanET) browsing this repo. Matches the same
# convention already in place in the sibling buem/weather repos. Previously
# tracked and already present in prior pushed commits/tags -- this only
# stops future changes from being committed, it doesn't rewrite history.
CLAUDE.md
.claude/

# Scenario working data/outputs (regenerated from buem/occupancy/weather and
# Calliope solves) -- scenarios/<country>/<scenario>/{data,outputs}/
scenarios/*/*/data/*
!scenarios/*/*/data/.gitkeep
scenarios/*/*/outputs/*
!scenarios/*/*/outputs/.gitkeep

# Scratch venvs used for local checks (not the project's real environment)
.venv_scenario_check/
.venv_calliope_check/
